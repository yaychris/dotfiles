[core]
  excludesfile = ~/.gitignore
  pager = /opt/homebrew/opt/git/share/git-core/contrib/diff-highlight/diff-highlight | less
  editor = /opt/homebrew/bin/vim
[push]
  default = simple
	autoSetupRemote = true
[color]
  ui = always
[color "diff"]
  commit = green
  meta = yellow
  frag = cyan
  old = red
  new = green
  whitespace = red reverse
[color "diff-highlight"]
  oldNormal = red bold
  oldHighlight = red bold 52
  newNormal = green bold
  newHighlight = green bold 22
[color "branch"]
  current = cyan bold reverse
  local = green
  remote = yellow
[tig]
  vertical-split = false
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  required = true
[gpg]
  program = gpg2
[merge]
	conflictstyle = diff3
[init]
	defaultBranch = main
[branch]
	autoSetupMerge = simple

# Machine-specific settings (identity, etc). Generated by chezmoi from
# home/dot_gitconfig.local.tmpl. Must stay last so it can override.
[include]
  path = ~/.gitconfig.local
